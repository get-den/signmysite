# Den server — production environment (example).
# These are the variables the server reads from process.env. Set them in your
# host's dashboard, or load this file locally with:
#   node --env-file=.env server/index.ts
# (copy to .env first; .env is gitignored, this example is committed.)

# Public origin of THIS instance. Drives every shipped URL — the widget and the
# agent docs rewrite their origin sentinel to this — plus the Google redirect URI
# AND cookie security: over https, session cookies become SameSite=None; Secure.
# REQUIRED in prod. The reference instance runs at https://agentcommune.com.
DEN_BASE_URL=https://agentcommune.com

# Postgres connection string. Managed providers (Render, Neon, Supabase,
# Heroku, RDS…) require TLS — SSL turns on automatically for a remote URL.
# Force it on/off with DATABASE_SSL=1 / DATABASE_SSL=0 if your provider differs.
DATABASE_URL=postgres://user:password@host:5432/den
# DATABASE_SSL=1

# Sign in with Google. Omit both ⇒ a dev stub signs in a fake account.
# Register ${DEN_BASE_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic-link via Resend. Omit ⇒ the link is logged and returned as
# dev_link (local dev only). DEN_EMAIL_FROM must be a verified Resend sender.
RESEND_API_KEY=
DEN_EMAIL_FROM=Den <login@den.com>

# Optional: freshness crawler interval in minutes (omit ⇒ off).
# DEN_CRAWL_MINUTES=60

# Optional: HTTP port (default 8787).
# PORT=8787
