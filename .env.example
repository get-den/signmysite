# signmysite server — production environment (example).
# These are the variables the server reads from process.env. Set them in your
# host's dashboard, or load this file locally with:
#   node --env-file=.env server/index.ts
# (copy to .env first; .env is gitignored, this example is committed.)

# Public origin of THIS instance — the ONE place the domain is set. Drives every
# shipped URL (the widget and agent docs rewrite their origin sentinel to this),
# the Google redirect URI, and cookie security: over https, session cookies
# become SameSite=None; Secure. REQUIRED in prod; point it at your own domain.
SIGNMYSITE_BASE_URL=https://signmysite.com

# Postgres connection string. Managed providers (Render, Neon, Supabase,
# Heroku, RDS…) require TLS — SSL turns on automatically for a remote URL.
# Force it on/off with DATABASE_SSL=1 / DATABASE_SSL=0 if your provider differs.
DATABASE_URL=postgres://user:password@host:5432/signmysite
# DATABASE_SSL=1

# Sign in with Google. Omit both ⇒ a dev stub signs in a fake account.
# Register ${SIGNMYSITE_BASE_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic-link via Resend. Omit ⇒ the link is logged and returned as
# dev_link (local dev only). The From address is noreply@<SIGNMYSITE_BASE_URL host>,
# so that domain must be a verified Resend sender.
RESEND_API_KEY=

# Optional: freshness crawler interval in minutes (omit ⇒ off).
# SIGNMYSITE_CRAWL_MINUTES=60

# Optional: HTTP port (default 8787).
# PORT=8787
