{
  "name": "den",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "npm run build && node --no-warnings server/index.ts",
    "serve": "node --no-warnings server/index.ts",
    "dev": "node --no-warnings --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "seed": "node --no-warnings server/seed.ts",
    "db:create": "createdb den 2>/dev/null || true"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
